@model List<Lead>
@{ ViewData["Title"] = "Khách tiềm năng"; var cur = (LeadStage?)ViewBag.Stage; }
<div class="card"><div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <form method="get" class="d-flex gap-2">
            <input name="q" value="@ViewBag.Q" class="form-control form-control-sm" placeholder="Tên / SĐT / mã..." style="max-width:200px" />
            <select name="stage" class="form-select form-select-sm" onchange="this.form.submit()" style="max-width:160px">
                <option value="">— Mọi giai đoạn —</option>
                @foreach (LeadStage s in Enum.GetValues(typeof(LeadStage))) { <option value="@((int)s)" selected="@(cur==s)">@Ui.Stage(s).text</option> }
            </select>
            <button class="btn btn-sm btn-primary">Lọc</button>
        </form>
        <a href="/Lead/Create" class="btn btn-sm btn-primary"><i class="bi bi-person-plus me-1"></i>Thêm lead</a>
    </div>
    <table class="table table-hover align-middle">
        <thead><tr><th>Mã</th><th>Khách hàng</th><th>Xe quan tâm</th><th>Nguồn</th><th>Sale</th><th>Giai đoạn</th></tr></thead>
        <tbody>
        @foreach (var l in Model)
        {
            var (txt, css) = Ui.Stage(l.Stage);
            <tr style="cursor:pointer" onclick="location.href='/Lead/Detail/@l.Id'">
                <td class="fw-semibold">@l.Code</td>
                <td>@l.Name <span class="text-muted small">· @l.Phone</span></td>
                <td class="small">@(l.Model?.Name ?? "—")</td>
                <td class="small text-muted">@Ui.Source(l.Source)</td>
                <td class="small">@l.SalesPerson</td>
                <td><span class="badge bg-@css">@txt</span></td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Không có lead.</td></tr> }
        </tbody>
    </table>
</div></div>
